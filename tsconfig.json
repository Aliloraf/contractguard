{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": ".build",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", ".build"]
}
